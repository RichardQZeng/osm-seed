#######################################
# Environment variable for web service
#######################################
# Server settings
SERVER_URL=127.0.0.1
SERVER_PROTOCOL=http

# Mailer settings for SES - AWS
MAILER_ADDRESS=email-smtp.us-east-1.amazonaws.com
MAILER_DOMAIN=osmseed.org
MAILER_USERNAME=...
MAILER_PASSWORD=...
MAILER_FROM=no-reply@osmseed.org
MAILER_PORT=25

# # Mailer settings for gmail
MAILER_ADDRESS=smtp.gmail.com
MAILER_DOMAIN=gmail.com
MAILER_AUTHENTICATION=login
MAILER_USERNAME=test@gmail.com
MAILER_PASSWORD=abc...
MAILER_FROM=no-reply@osmseed.org
MAILER_PORT=25
OPENSTREETMAP_memcache_servers=""

# Nominatim settings
NOMINATIM_URL=nominatim-api

# OAuth 2 settings
# The bundled start script registers iD and the website as OAuth 2 applications
# at initial startup. Preserve the generated values when recreating the container.
OPENSTREETMAP_id_key=""
OAUTH_CLIENT_ID=""
OAUTH_KEY=""

# NEW_RELIC settings
# TODO: Needs to be implemented the New Relic functions in order to make running in the web container
NEW_RELIC_LICENSE_KEY="..."
NEW_RELIC_APP_NAME="..."

ORGANIZATION_NAME=OSMSeed
WEBSITE_STATUS=online

# Storage: local or s3 are good choices
OPENSTREETMAP_avatar_storage=s3
OPENSTREETMAP_trace_file_storage=s3
OPENSTREETMAP_trace_image_storage=s3
OPENSTREETMAP_trace_icon_storage=s3

# Optional Rails credentials; default values are used when unset.
RAILS_MASTER_KEY=""
RAILS_CREDENTIALS_YML_ENC=""

# Initial admin account. Password must be at least 8 characters when set.
ADMIN_MAIL="admin@osmseed.org"
ADMIN_PASSWORD=""
